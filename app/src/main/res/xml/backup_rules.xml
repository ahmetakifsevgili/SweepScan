<?xml version="1.0" encoding="utf-8"?>
<!-- Android's cloud backup and device-to-device transfer: the map, its layout, settings and requests. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="locations.db" />
        <include domain="file" path="layout.json" />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="locations.db" />
        <include domain="file" path="layout.json" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
