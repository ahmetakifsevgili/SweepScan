<?xml version="1.0" encoding="utf-8"?>
<!--
    The camera screen: the picture fills the screen; controls float on soft gradients, not on
    solid bars. Top: back / task, torch, settings, then the count. Bottom: zoom capsule, the last
    counted boxes, and undo / pause / finish in thumb reach.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.sweepscan.ui.OverlayView
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Soft shade behind the floating controls, so they read on any picture. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_gravity="top"
        android:background="@drawable/scrim_top" />

    <View
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_gravity="bottom"
        android:background="@drawable/scrim_bottom" />

    <!-- Paused: dims the camera picture only; every control stays on top of it. -->
    <TextView
        android:id="@+id/paused_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#A6000000"
        android:drawablePadding="12dp"
        android:gravity="center"
        android:lineSpacingExtra="6dp"
        android:text="@string/paused_overlay"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:drawableTopCompat="@drawable/ic_play_big" />

    <!-- Top: task (tap = back), torch, settings; then the count and the PC status. -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.chip.Chip
                android:id="@+id/mode_chip"
                style="@style/GlassChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_locate"
                style="@style/GlassIcon"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/loc_title"
                android:visibility="gone"
                app:icon="@drawable/ic_search" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_torch"
                style="@style/GlassIcon"
                android:layout_marginEnd="8dp"
                android:checkable="true"
                android:contentDescription="@string/torch"
                app:icon="@drawable/ic_flash" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_settings"
                style="@style/GlassIcon"
                android:contentDescription="@string/settings"
                app:icon="@drawable/ic_settings" />
        </LinearLayout>

        <TextView
            android:id="@+id/state_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:letterSpacing="0.08"
            android:textColor="@color/ok"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/total_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:shadowColor="#80000000"
            android:shadowRadius="8"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold" />

        <com.google.android.material.chip.Chip
            android:id="@+id/status_text"
            style="@style/GlassChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxWidth="320dp"
            android:maxLines="1"
            app:chipIcon="@drawable/ic_pc"
            app:chipIconTint="#FFFFFF" />

        <TextView
            android:id="@+id/suspects_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/glass_card"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:textColor="#FFD58A"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tour_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/brand"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/hud_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:textColor="@color/brand"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

    <View
        android:id="@+id/count_flash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@drawable/count_flash" />

    <TextView
        android:id="@+id/hint_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="24dp"
        android:background="@drawable/hint_bg"
        android:gravity="center"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Bottom: zoom, what was just counted, then undo, the big pause/resume, finish. -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="16dp">

        <!-- Zoom as in a phone's camera app: one capsule, the chosen step lit. -->
        <LinearLayout
            android:id="@+id/quick_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="14dp"
            android:background="@drawable/glass_capsule"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="4dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/zoom_auto"
                style="@style/ZoomButton"
                android:layout_width="wrap_content"
                android:layout_marginEnd="4dp"
                android:checkable="true"
                android:paddingHorizontal="12dp"
                android:text="@string/zoom_auto" />

            <LinearLayout
                android:id="@+id/zoom_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/zoom_1"
                    style="@style/ZoomButton"
                    android:checkable="true"
                    android:text="1×" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/zoom_15"
                    style="@style/ZoomButton"
                    android:checkable="true"
                    android:text="1,5×" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/zoom_2"
                    style="@style/ZoomButton"
                    android:checkable="true"
                    android:text="2×" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/zoom_3"
                    style="@style/ZoomButton"
                    android:checkable="true"
                    android:text="3×" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/recent_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:letterSpacing="0.05"
            android:text="@string/recent_title"
            android:textColor="#CCFFFFFF"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/recent_strip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="14dp"
            android:orientation="horizontal" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_undo"
                style="@style/BarButton"
                android:text="@string/undo"
                app:icon="@drawable/ic_undo" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_scan"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginHorizontal="10dp"
                android:layout_weight="1.3"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:maxLines="1"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:text="@string/pause"
                android:textSize="17sp"
                android:textStyle="bold"
                app:cornerRadius="32dp"
                app:icon="@drawable/ic_pause"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconSize="24dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_finish"
                style="@style/BarButton"
                android:text="@string/finish"
                app:icon="@drawable/ic_done" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
