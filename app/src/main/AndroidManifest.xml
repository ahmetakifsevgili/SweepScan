<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.camera.any" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Needed to make the phone discoverable so the laptop can pair with it as a keyboard. -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <!-- Request notifications ("0209 13243 → Büyük depo · 3. sıra"). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 16+: the "typing into DİA" progress may show as a Live Update (status bar chip). -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- Depot ↔ shop floor over the shop's own Wi-Fi (DepotServer / ShopClient); nothing on the internet. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- A shop phone installs the newer app the depot phone serves (asks the user each time). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- The phone's speech recogniser, for saying a code ("Söyle"). -->
    <queries>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <application
        android:name=".SweepScanApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/backup_rules"
        android:fullBackupContent="@xml/backup_rules_old"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security"
        android:theme="@style/Theme.SweepScan">

        <!-- The app starts on the home screen; the camera opens only for a job. -->
        <activity
            android:name=".ui.HomeActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <activity
            android:name=".ui.RequestsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.SweepScan.Fullscreen" />

        <activity
            android:name=".ui.RowListActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.OnboardingActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.SessionActivity"
            android:exported="false"
            android:label="@string/session_title"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.LocationActivity"
            android:exported="false"
            android:label="@string/loc_title"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- WhatsApp → Paylaş → SweepScan: a request shared by hand (both versions). -->
        <activity
            android:name=".request.ShareRequestActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/share_label"
            android:theme="@style/Theme.SweepScan">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".request.RequestActionReceiver"
            android:exported="false" />

        <!-- Home-screen widget: waiting requests, read a box, search. -->
        <receiver
            android:name=".ui.HomeWidget"
            android:exported="false"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_home_info" />
        </receiver>

        <!-- Presentation mode's rehearsal group: receives the answers instead of WhatsApp. -->
        <receiver
            android:name=".request.RehearsalReceiver"
            android:exported="false" />

        <!-- Quick settings tile: say a code from the notification shade. -->
        <service
            android:name=".request.SayTileService"
            android:exported="true"
            android:icon="@drawable/ic_mic"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <activity
            android:name=".request.VoiceRequestActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.SweepScan" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- The installer's answer when a shop phone updates itself from the depot phone. -->
        <receiver
            android:name=".server.AppUpdate$Receiver"
            android:exported="false" />
        <!-- Shop floor: ask the depot for a shoe and follow it. -->
        <activity
            android:name=".ui.ShopActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- The depot phone's server for the shop floor and the panel (Ayarlar → Mağaza bağlantısı). -->
        <service
            android:name=".server.DepotService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Local Wi-Fi server: shop-floor phones send product requests to the stock room phone and see their status." />
        </service>
    </application>
</manifest>
